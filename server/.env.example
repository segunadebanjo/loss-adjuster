# --- Server ---
NODE_ENV=development
PORT=4100
# Comma-separated origins allowed to call the API with credentials (the Vite dev server by default).
CORS_ORIGINS=http://localhost:5174

# --- Database (docker compose up -d) ---
DATABASE_URL=mysql://la:la@localhost:3306/loss_adjuster
# Tests create and drop throwaway databases named la_test_* on this server.
TEST_DATABASE_URL=mysql://la:la@localhost:3306/la_test

# --- Auth ---
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_COST=12

# --- File storage ---
# cloudinary | s3 | local. "local" keeps files in STORAGE_DIR and is for development only (refused in production).
STORAGE_DRIVER=local
STORAGE_DIR=./storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder (Cloudinary) or key prefix (S3) for every file this app stores.
STORAGE_FOLDER=loss-adjuster
# Used when STORAGE_DRIVER=s3
AWS_REGION=af-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_ENDPOINT=

# --- The firm, as printed on reports and fee notes (replace every placeholder before issuing documents) ---
FIRM_NAME=Pinnacle Loss Adjusters Ltd
FIRM_ADDRESS=[Firm address], Lagos
FIRM_RC_NUMBER=RC [000000]
FIRM_NAICOM_LICENCE=NAICOM/LA/[0000]
FIRM_EMAIL=claims@[firm-domain]
FIRM_PHONE=+234 [000 000 0000]
FIRM_TIN=[TIN]
FIRM_BANK_NAME=[Bank name]
FIRM_ACCOUNT_NAME=[Account name]
FIRM_ACCOUNT_NUMBER=[0000000000]
# PNG or JPG, relative to the server folder (e.g. assets/logo.png). Leave blank for no logo.
FIRM_LOGO_PATH=

# --- Fee notes; percentages ---
VAT_RATE=7.5
WHT_RATE=10

# --- Seed ---
# Password given to every seeded user (development only).
SEED_PASSWORD=Password123!
